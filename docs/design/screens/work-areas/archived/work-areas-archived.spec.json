    "archived_location": "inside Work Areas → Focus Areas, entered via compact View archived control; not a third primary tab",
    "detail": "read only",
    "restore": "preserve current restore behavior and existing domain validations",
    "delete": "preserve existing deletion checks and two-stage warning when history exists; blocked by active/paused timers",
