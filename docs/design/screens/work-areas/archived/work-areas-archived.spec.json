    "metrics": "mockups show time totals for visual reference only; fetch/display only if existing API supports them, otherwise omit and reflow",
    "search": "search field is visual proposal only; do not add a new search feature without separate approval",
    "confirmation": "restore dialog is an optional illustrative design; do not change the existing direct restore flow without approval"
  },
