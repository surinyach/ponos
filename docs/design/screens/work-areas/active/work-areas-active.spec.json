  "component_rules": {
    "sort": {
      "priority": "ascending numeric (P1 first)",
      "tie_break": "ascending stable ID",
      "manual_reorder": false
    },
    "expiration": {
      "local_date": "2026-10-13 reference fixture only",
      "not_expired_on_end_date": true,
      "days_1_to_14": "warning yellow + triangle icon + text",
      "days_15_plus": "danger red + triangle icon + text",
      "no_auto_archive": true,
      "non_applicable_target_after_finish": true
    },
    "day_targets": "positive integers only for enabled weekdays; any positive minute count",
    "card_tap": "opens edit route; secondary ellipsis opens archive confirmation, both keyboard accessible",
    "archived": "compact button under Focus Areas tab, do not add Archived as primary tab",
    "empty": "existing AppAssets.emptyFocusAreas may be used for Focus Areas empty view; no new asset required",
    "work_goals": "This daily target summary is illustrative and must bind to existing correct provider values; do not introduce new Work Goal business logic or fake production values.",
    "navigation": {
      "mobile_under_600": "bottom",
      "mobile_600_plus": "lateral rail",
      "desktop_web": "lateral always",
      "expanded_sidebar_from": 1200
    },
    "min_interaction_target_dp": 48,
    "radius": {
      "cards": 12,
      "buttons": 10,
      "chips": 8
    },
    "typography": {
      "family": "Inter",
      "do_not_scale_type_with_viewport": true,
      "use_flutter_text_scaler": true
    },
    "responsive": {
      "width": "content-driven, preserve insets",
      "height": "vertically scrollable when content exceeds available area",
      "enlarged_text": "wrap text; preserve minimum targets; natural card heights"
    },
    "reuse_runtime_assets": "Use existing Ponos emblem/theme/widgets. The SVG/PNG files here are design references, not runtime graphical replacements."
  },
